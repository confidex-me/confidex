FROM docker.io/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /data && chown 10001:10001 /data
ARG TARGETARCH
COPY --chmod=0755 bin/${TARGETARCH}/confidexsyncd /usr/local/bin/confidexsyncd
COPY licenses/ /usr/share/licenses/confidexsyncd/
COPY bin/${TARGETARCH}/SOURCE.json /usr/share/licenses/confidexsyncd/SOURCE.json
ENV LISTEN_ADDRESS=0.0.0.0 LISTEN_PORT=8080 INDEX_URL=/data/index.sqlite BACKEND_POSIX_PATH_0=/data/objects
USER 10001:10001
VOLUME ["/data"]
EXPOSE 8080
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/confidexsyncd"]
