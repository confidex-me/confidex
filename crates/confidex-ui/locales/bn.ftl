export-generate = ফাইল প্রস্তুত করুন
export-restart = আবার শুরু করুন
export-reviewing = রেকর্ড পড়া এবং রপ্তানি পরীক্ষা করা হচ্ছে…
export-writing = রপ্তানি ফাইল প্রস্তুত করা হচ্ছে…
export-restart-hint = বিন্যাস ও রেকর্ড বেছে নিতে বা আবার সংরক্ষণের চেষ্টা করতে আবার শুরু করুন।
export-no-formats = এই সংস্করণে রপ্তানির কোনো বিন্যাস নেই। আপনি এখনও ভল্টের এনক্রিপ্ট করা ব্যাকআপ তৈরি করতে পারেন।
export-allow-losses = উপরে উল্লিখিত সব ক্ষতি আমি মেনে নিচ্ছি
export-plaintext-ack = আমি বুঝতে পারছি যে এই ফাইলে পড়া যায় এমন গোপন তথ্য থাকবে
export-plaintext-hint = রপ্তানি করা ফাইল নিরাপদে রাখুন। ভল্ট লক করলে আগে সংরক্ষিত বা ডাউনলোড করা ফাইল মুছে যায় না।
export-local-hint = এই ডিভাইসেই প্রক্রিয়াকরণ হয়। রপ্তানি ভল্ট পরিবর্তন করে না।
export-changed = রপ্তানির সময় রেকর্ড বদলে গেছে। বর্তমান মান পর্যালোচনা করতে আবার শুরু করুন।
export-canceled = রপ্তানি বাতিল করা হয়েছে। এই কাজ কোনো নতুন রপ্তানি ফাইল তৈরি করেনি।
export-limit = রপ্তানি উপলব্ধ মেমরি বা ফাইলের আকারের সীমা ছাড়িয়েছে। কম রেকর্ড রপ্তানি করুন।
export-error = রপ্তানি প্রস্তুত করা যায়নি। আবার শুরু করুন বা অন্য বিন্যাস বেছে নিন।
export-file-error = ফাইল খোলা বা সংরক্ষণ করা যায়নি। আবার চেষ্টা করতে আবার শুরু করুন।
export-code-unsupported-field = এই বিন্যাস এই ক্ষেত্র প্রকাশ করতে পারে না।
export-code-unknown-value = এই বিন্যাস এই মান প্রকাশ করতে পারে না।
export-code-unknown-metadata = রেকর্ডের অতিরিক্ত তথ্য প্রকাশ করা যায় না।
export-code-protection = ক্ষেত্রের সুরক্ষা বদলে যাবে।
export-code-field-order = ক্ষেত্রের ক্রম বজায় রাখা যায় না।
export-code-field-names = ক্ষেত্রের নাম হুবহু বজায় রাখা যায় না।
export-code-urls = একাধিক URL হুবহু বজায় রাখা যায় না।
export-code-totp = একবার ব্যবহারযোগ্য পাসওয়ার্ডের কিছু পরামিতি বজায় রাখা যায় না।
export-code-attachments = ফাইল বা ছবি হুবহু বজায় রাখা যায় না।
export-code-tags = ট্যাগ বা উৎস গোষ্ঠী হুবহু বজায় রাখা যায় না।
export-code-sections = ক্ষেত্রের বিভাগ হুবহু বজায় রাখা যায় না।
export-code-source-context = মূল আমদানি তথ্য এই বিন্যাসে বজায় রাখা যায় না।
export-code-history = উৎসের ঐতিহাসিক তথ্য বজায় রাখা যায় না।
export-change = বিন্যাস বা রেকর্ড বদলান
export-previous = আগের সমস্যাগুলো
export-next = পরের সমস্যাগুলো

vault-add-website = ওয়েবসাইট যোগ করুন
vault-add-location = অবস্থান যোগ করুন

vault-exit-title = সংরক্ষণ না করা পরিবর্তন
vault-exit-body = আপনার পরিবর্তনগুলি সংরক্ষণ করা হয়নি।
vault-exit-lock = বাতিল করে লক করুন
vault-exit-close = বাতিল করে বন্ধ করুন

export-bitwarden-profile = Bitwarden প্রোফাইল
export-bitwarden-personal = ব্যক্তিগত
export-bitwarden-organization = সংস্থা
export-bitwarden-profile-hint = ব্যক্তিগত: প্রথম ট্যাগটি একটি ফোল্ডার হবে। সংস্থা: ট্যাগগুলি সংগ্রহ হবে। প্রবেশাধিকারের অনুমতি স্থানান্তরিত হবে না।
settings-auto-lock = নিষ্ক্রিয় থাকলে লক করুন
settings-auto-lock-hint = এই সেটিং শুধু এই ডিভাইসে এই ভল্টের জন্য প্রযোজ্য। আবার খুলতে ভল্ট আনলক করতে হবে।
settings-device-unlock-error = ডিভাইস দিয়ে আনলক করার সেটিং বদলানো যায়নি। আবার চেষ্টা করুন।
