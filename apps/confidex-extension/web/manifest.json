{
  "manifest_version": 3,
  "name": "Confidex",
  "version": "0.1.0",
  "incognito": "not_allowed",
  "minimum_chrome_version": "106",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": { "default_title": "Confidex", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' https:"
  }
}
